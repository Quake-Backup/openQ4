windowDef Desktop
{
	rect		0,0,640,480
	menugui		1
	noclip		1

	onActivate {
		if ( "gui::demo_browserMode" == 1 ) {
			setfocus "demoList" ;
		}
	}

	onESC {
		if ( "gui::demo_interactive" == 1 ) {
			set "cmd" "demoClose" ;
		}
	}

	// Browser backdrop.
	windowDef demo_browser_backdrop
	{
		rect		( 0 - "gui::virtual_screen_x_expand" ),( 0 - "gui::virtual_screen_y_expand" ),( 640 + ( "gui::virtual_screen_x_expand" * 2 ) ),( 480 + ( "gui::virtual_screen_y_expand" * 2 ) )
		visible		( "gui::demo_browserMode" == 1 && "gui::demo_interactive" == 1 )
		backcolor	0.015,0.02,0.018,1
		noevents	1
	}

